#!/usr/bin/env sh

COMMIT_MSG_FILE="$1"

# Read the first line of commit message
first_line=$(head -n1 "$COMMIT_MSG_FILE")

# Skip Commitizen if the message already follows Conventional Commit format
case "$first_line" in
  feat:*|fix:*|chore:*|docs:*|style:*|refactor:*|perf:*|test:*|build:*|ci:*)
    exit 0
    ;;
esac

# Otherwise run Commitizen interactively
exec < /dev/tty && npx cz --hook || true
