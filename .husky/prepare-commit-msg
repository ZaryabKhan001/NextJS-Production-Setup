#!/usr/bin/env sh

# Skip running commitizen for non-interactive commits or when a message already exists
# $1 - commit message file, $2 - commit source (message, template, merge, squash, etc.)
COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# If the commit message file already has content (e.g. -m "msg"), skip cz
if [ -s "$COMMIT_MSG_FILE" ]; then
  exit 0
fi

# Skip for merges/squashes and when commit source is 'message'
case "$COMMIT_SOURCE" in
  merge|squash|message)
    exit 0
    ;;
esac

# Otherwise run commitizen interactively
exec < /dev/tty && npx cz --hook || true